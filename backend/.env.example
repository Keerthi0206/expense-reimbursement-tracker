# Copy this file to .env and fill in real values. Never commit .env itself.

# A long, random string in production. The default below is fine for local dev only.
SECRET_KEY=dev-secret-change-me-in-production

# SQLite is the default and needs no setup. Swap for Postgres in production, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/expense_tracker
DATABASE_URL=sqlite:///./expense_tracker.db

# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000

UPLOAD_DIR=./uploads/receipts

# How many days a request can sit in Submitted/Under Review before a reminder
# notification goes out to reviewers/admins.
REMINDER_THRESHOLD_DAYS=3

# How often (in minutes) the background scheduler checks for stale requests.
# A short interval doesn't mean frequent notifications -- each request only
# gets reminded about once per REMINDER_THRESHOLD_DAYS.
REMINDER_CHECK_INTERVAL_MINUTES=60

# Requests over this amount (or in a category listed in
# backend/app/core/workflow_rules.py) need a second, admin-level approval
# in addition to the normal single reviewer approval.
SECOND_APPROVAL_AMOUNT_THRESHOLD=500
